# Plusalator Makefile — portable: standard Linux defaults, Termux honored
# via $PREFIX / $TMPDIR (set automatically in the Termux environment).
CXX ?= clang++
CXXFLAGS := -Wall -Wextra -O2 -std=c++17

# Respect $TMPDIR when set; fall back to /tmp (Linux) — Termux sets $TMPDIR.
TMPDIR ?= /tmp
export TMPDIR

# Respect $PREFIX when set; fall back to /usr/local (Linux install prefix).
# Termux sets $PREFIX to its own install root automatically.
PREFIX ?= /usr/local
export PREFIX

SRC := src/calc.cpp src/main.cpp src/lineedit.cpp
OBJ := $(SRC:.cpp=.o)
BIN := plusalator

.PHONY: all run check clean install banner

all: $(BIN)

$(BIN): $(OBJ)
	$(CXX) $(CXXFLAGS) -o $@ $(OBJ)

src/%.o: src/%.cpp src/calc.h src/lineedit.h
	$(CXX) $(CXXFLAGS) -c -o $@ $<

run: all
	TMPDIR="$(TMPDIR)" ./$(BIN)

check: all
	TMPDIR="$(TMPDIR)" bash tests/test.sh
	$(CXX) $(CXXFLAGS) -fsyntax-only src/calc.cpp src/main.cpp

clean:
	rm -f $(OBJ) $(BIN)

install: all
	install -d "$(PREFIX)/bin"
	install -m 0755 $(BIN) "$(PREFIX)/bin/plusalator"

banner:
	@if command -v figlet >/dev/null 2>&1; then \
		figlet -f big Plusalator > "$(TMPDIR)/plusalator-figlet.out"; \
		{ \
			echo '// generated by make banner - DO NOT EDIT'; \
			echo '#pragma once'; \
			echo '#include <string>'; \
			echo 'inline const std::string& bannerText() {'; \
			echo '  static const std::string text = R"EOF('; \
			cat "$(TMPDIR)/plusalator-figlet.out"; \
			echo ')EOF";'; \
			echo '  return text;'; \
			echo '}'; \
		} > src/banner.h.new; \
		mv src/banner.h.new src/banner.h; \
		rm -f "$(TMPDIR)/plusalator-figlet.out"; \
	else \
		echo "figlet not installed; on Termux: pkg install figlet"; \
		echo "          on Linux:  install figlet via your distro package manager"; \
		exit 1; \
	fi
